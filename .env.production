# Committed on purpose — these are Supabase's PUBLIC anon key and project URL.
# Supabase is designed so this pair is safe to ship inside a client bundle;
# real access control happens via Row Level Security (RLS) policies on the
# database, not by hiding this key. This lets GitHub Pages / Cloudflare
# Workers builds run with zero secrets configured anywhere.
#
# NEVER put the Supabase Service Role Key here or in any VITE_* variable —
# that key bypasses RLS entirely and must only ever live server-side (e.g.
# as a Supabase Edge Function secret), never in a frontend build.
VITE_SUPABASE_URL=https://smmvsijxencnimmyhjul.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNtbXZzaWp4ZW5jbmltbXloanVsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODUzMDU0NzEsImV4cCI6MjEwMDg4MTQ3MX0.3NxZ0_4D-z8iFgfNWRzFHEm43o_B8_pknZSuHru8E6M
